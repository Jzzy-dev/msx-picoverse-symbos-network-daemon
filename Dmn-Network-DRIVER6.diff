+        ex (sp),ix              ;no overall-status change -> skip
+        jp netpol0
+netudp1 ld (netudps),hl
+        pop hl                  ;hl,iy=ip
+        push ix
+        push af
+        ld (ix+sckdatsta+0),a       ;store new status
+        ld (ix+sckdatrcv+0),c       ;store received bytes
+        ld (ix+sckdatrcv+1),b
